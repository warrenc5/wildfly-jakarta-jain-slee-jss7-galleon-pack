<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd"
>

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.mobicents.protocols.ss7</groupId>
        <artifactId>restcomm-ss7-wildfly</artifactId>
        <version>9.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wildfly-restcomm-ss7-galleon-pack</artifactId>

    <packaging>pom</packaging>

    <properties>
        <version.mobicents>9.0.0-SNAPSHOT</version.mobicents>
    </properties>

    <profiles>
        <profile>
            <id>wildfly-21.0.1.Final</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>WF21</name>
                </property>
            </activation>
            <properties>
                <version.wildfly>21.0.1.Final</version.wildfly>
                <version.org.wildfly>${version.wildfly}</version.org.wildfly>
                <version.wildfly.embedded>21.1.1.Final</version.wildfly.embedded>
            </properties>
        </profile>
        <profile>
            <id>wildfly-26.1.3.Final</id>
            <activation>
                <activeByDefault>false</activeByDefault>
                <property>
                    <name>WF26</name>
                </property>
            </activation>
            <properties>
                <version.wildfly>26.1.3.Final</version.wildfly>
                <version.org.wildfly>${version.wildfly}</version.org.wildfly>
                <version.wildfly.embedded>26.0.1.Final</version.wildfly.embedded>
                <version.wildfly.cli>18.1.2.Final</version.wildfly.cli>
                <version.wildfly.core>26.0.1.Final</version.wildfly.core>
            </properties>
        </profile>
        <profile>
            <id>wildfly-39.0.0.Final</id>
            <activation>
                <activeByDefault>true</activeByDefault>
                <property>
                    <name>WF39</name>
                </property>
            </activation>
            <properties>
                <version.wildfly>39.0.0.Final</version.wildfly>
                <version.org.wildfly>${version.wildfly}</version.org.wildfly>
                <version.wildfly.embedded>31.0.1.Final</version.wildfly.embedded>
                <version.wildfly.cli>31.0.1.Final</version.wildfly.cli>
                <version.wildfly.core>31.0.1.Final</version.wildfly.core>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>

        <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
        <execution>
        <id>clean-on-compile</id>
        <phase>compile</phase>
        <goals>
        <goal>clean</goal>
        </goals>
        </execution>
        </executions>
        </plugin>

            <plugin>
                <groupId>org.wildfly.galleon-plugins</groupId>
                <artifactId>wildfly-galleon-maven-plugin</artifactId>
                <version>8.1.0.Final</version>
                <executions>
                    <execution>
                        <id>default</id>
                        <goals>
                            <goal>build-feature-pack</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <generateCompleteModel>true</generateCompleteModel>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-databind</artifactId>
                        <version>2.18.2</version>
                    </dependency>
                    <dependency>
                        <groupId>com.fasterxml.jackson.core</groupId>
                        <artifactId>jackson-core</artifactId>
                        <version>2.18.2</version>
                    </dependency>
                    <dependency>
                        <groupId>org.wildfly.core</groupId>
                        <artifactId>wildfly-embedded</artifactId>
                        <version>${version.wildfly.embedded}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.wildfly</groupId>
                        <artifactId>wildfly-client-all</artifactId>
                        <version>${version.org.wildfly}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.wildfly</groupId>
            <artifactId>wildfly-galleon-pack</artifactId>
            <version>${version.wildfly}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>org.mobicents.servers.jainslee.core</groupId>
            <artifactId>wildfly-mobicents-slee-galleon-pack</artifactId>
            <version>${version.mobicents}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>restcomm-ss7-wildfly-modules</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>restcomm-ss7-wildfly-extension</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <pluginRepositories>
        <pluginRepository>
            <id>jboss-release</id>
            <name>Jboss Release</name>
            <url>https://repository.jboss.org/nexus/content/repositories/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>jboss</id>
            <name>Jboss Repo</name>
            <url>https://repository.jboss.org/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>redhat-ga</id>
            <name>Redhat GA</name>
            <url>https://maven.repository.redhat.com/ga/</url>
        </pluginRepository>
    </pluginRepositories>
    <repositories>
        <repository>
            <id>jboss-release</id>
            <name>Jboss Release</name>
            <url>https://repository.jboss.org/nexus/content/repositories/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jboss</id>
            <name>Jboss Repo</name>
            <url>https://repository.jboss.org/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>redhat-ga</id>
            <name>Redhat GA</name>
            <url>https://maven.repository.redhat.com/ga/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
